# Entorno
APP_ENV=development
PUBLIC_BASE_URL=https://tu-dominio.example.com
PORT=8000

# Anthropic
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-haiku-4-5-20251001

# Operador NEXXUS
OPERADOR_USER=
OPERADOR_PASSWORD=

# Credenciales por negocio. Reemplaza FUERZA_TOTAL por el slug en mayúsculas.
ADMIN_USER_FUERZA_TOTAL=
ADMIN_PASSWORD_FUERZA_TOTAL=

# Protección de costos
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SUPERVISOR_PHONE_NUMBER=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# Desarrollo local. En producción usar PostgreSQL.
NEXXUS_DB_PATH=nexxus_core.sqlite
